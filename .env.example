NODE_ENV=development
PORT=8080
META_VERIFY_TOKEN=replace-me
META_APP_ID=replace-me
META_APP_SECRET=replace-me
META_PAGE_ACCESS_TOKEN=replace-me
META_GRAPH_VERSION=v25.0
META_PAGE_ID=replace-me
META_ACTIVE_PAGE=primary
META_TEST_PAGE_ID=
META_TEST_PAGE_ACCESS_TOKEN=
META_LIVE_SEND_ENABLED=false
MULTI_ACTION_ROLLOUT_MODE=shadow
MULTI_ACTION_CANARY_PERCENT=0
# Bắt buộc true nếu muốn canary/enabled trên Page primary.
MULTI_ACTION_PRIMARY_APPROVED=false
META_STAFF_NAME="Mai Lan"
META_OPENING_VARIANT=AUTO.dynamic
META_WORKER_CONSUMER=worker-1
META_DEBOUNCE_MS=6000
META_GATEWAY_PORT=8081
META_GATEWAY_ENABLED=false
# URL HTTPS mà Meta thực sự gọi, ví dụ https://bot.example.com/webhooks/meta
META_PUBLIC_WEBHOOK_URL=
DATABASE_URL=postgresql://stopirex:stopirex@localhost:15432/stopirex
REDIS_URL=redis://localhost:6379
ADMIN_API_KEY=replace-me
ENCRYPTION_KEY=replace-with-32-byte-secret
DATA_RETENTION_DAYS=90
OUTBOUND_WINDOW_HOURS=24

# Follow-up 3/6/9 giờ. Mặc định shadow chỉ ghi nhận quyết định, không gửi khách.
FOLLOWUP_MODE=shadow
FOLLOWUP_WORKER_CONSUMER=followup-worker-1
FOLLOWUP_POLL_MS=1000
FOLLOWUP_BATCH_SIZE=50
FOLLOWUP_MAX_ATTEMPTS=3
FOLLOWUP_CLAIM_TTL_MS=60000
# Bắt buộc true trước khi FOLLOWUP_MODE=enabled trên Page primary.
FOLLOWUP_PRIMARY_APPROVED=false

# LLM chính. auto ưu tiên OpenAI API khi có key, nếu chưa có key thì dùng Codex CLI local.
LLM_PROVIDER=hybrid
LLM_ENABLED=true
OPENAI_API_KEY=
# Endpoint tương thích OpenAI Responses API; giữ mặc định cho OpenAI chính thức.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-nano
LLM_PROMPT_PROFILE=compact
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_OUTPUT_TOKENS=1200
LLM_USD_TO_VND_RATE=26000
LLM_HYBRID_PROVIDER_TIMEOUT_MS=15000
LLM_HYBRID_FALLBACK_TIMEOUT_MS=30000
LLM_HYBRID_HEDGE_DELAY_MS=2500
LLM_HYBRID_COOLDOWN_MS=300000
# Tùy chọn khi API key thuộc organization/project cụ thể.
# OPENAI_ORGANIZATION=org_...
# OPENAI_PROJECT=proj_...

# Codex CLI chỉ là phương án local dự phòng khi chưa cấu hình OPENAI_API_KEY.
CODEX_LLM_ENABLED=true
CODEX_CLI_PATH=/Applications/ChatGPT.app/Contents/Resources/codex
CODEX_LLM_TIMEOUT_MS=30000
CODEX_LLM_MODEL=gpt-5.4-mini
CODEX_LLM_REASONING_EFFORT=low
