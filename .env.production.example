# Production template. Inject values through a secret manager or protected env file.
NODE_ENV=production
PORT=8080
META_VERIFY_TOKEN=replace-production-verify-token
META_APP_ID=replace-production-app-id
META_APP_SECRET=replace-production-app-secret
META_PAGE_ID=replace-production-page-id
META_PAGE_ACCESS_TOKEN=replace-production-page-token
META_ACTIVE_PAGE=primary
META_GRAPH_VERSION=v25.0
META_LIVE_SEND_ENABLED=false
MULTI_ACTION_ROLLOUT_MODE=shadow
MULTI_ACTION_CANARY_PERCENT=0
MULTI_ACTION_PRIMARY_APPROVED=false
FOLLOWUP_MODE=shadow
FOLLOWUP_PRIMARY_APPROVED=false
META_PUBLIC_WEBHOOK_URL=https://bot.example.com/webhooks/meta
DATABASE_URL=postgresql://user:password@db.internal:5432/stopirex
REDIS_URL=redis://redis.internal:6379
ADMIN_API_KEY=replace-production-admin-key
ENCRYPTION_KEY=replace-with-32-byte-production-secret

LLM_PROVIDER=hybrid
LLM_ENABLED=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-nano
CODEX_LLM_ENABLED=false
