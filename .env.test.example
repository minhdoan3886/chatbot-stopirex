# Local/test only. Copy to .env and fill secrets outside Git.
NODE_ENV=development
PORT=8080
META_VERIFY_TOKEN=replace-test-verify-token
META_APP_ID=replace-test-app-id
META_APP_SECRET=replace-test-app-secret
META_TEST_PAGE_ID=replace-test-page-id
META_TEST_PAGE_ACCESS_TOKEN=replace-test-page-token
META_ACTIVE_PAGE=test
META_GRAPH_VERSION=v25.0
META_LIVE_SEND_ENABLED=false
MULTI_ACTION_ROLLOUT_MODE=shadow
MULTI_ACTION_CANARY_PERCENT=0
MULTI_ACTION_PRIMARY_APPROVED=false
FOLLOWUP_MODE=shadow
FOLLOWUP_PRIMARY_APPROVED=false
META_PUBLIC_WEBHOOK_URL=https://replace-test-domain.example/webhooks/meta
DATABASE_URL=postgresql://stopirex:stopirex@127.0.0.1:15432/stopirex
REDIS_URL=redis://127.0.0.1:6379
ADMIN_API_KEY=replace-test-admin-key
ENCRYPTION_KEY=replace-with-32-byte-test-secret

# Optional LLM settings; never commit API keys.
LLM_PROVIDER=hybrid
LLM_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
CODEX_LLM_ENABLED=true
CODEX_CLI_PATH=/Applications/ChatGPT.app/Contents/Resources/codex
CODEX_LLM_MODEL=gpt-5.4-mini
