{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StopirexSemanticUnderstanding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "skill",
    "intent",
    "propositions",
    "actions",
    "claimedSavedFields",
    "uncertainties",
    "knowledgeIds",
    "knowledgeQueries",
    "unsupportedQuestions",
    "answeredQuestions",
    "newAngle",
    "rejectedArguments",
    "nextStep",
    "selectedCtaId",
    "ctaText",
    "beneficiaryUpdates",
    "groundingConfidence",
    "draftReply",
    "draftBubbles",
    "confidence",
    "needsClarification",
    "evidence",
    "asksDirectAnswer",
    "topic",
    "subject",
    "scenario",
    "replyTo",
    "affirmation",
    "age",
    "priceFromVnd",
    "priceToVnd",
    "discountAmountVnd",
    "workContext",
    "primarySymptom",
    "sweatPresent",
    "odorPresent",
    "priorProduct",
    "priorIrritation"
  ],
  "properties": {
    "summary": { "type": "string" },
    "skill": {
      "type": "string",
      "enum": [
        "direct-answer",
        "need-discovery",
        "solution-guidance",
        "pricing-objection",
        "order-closing",
        "after-sales-care",
        "safety-first",
        "knowledge-handoff",
        "follow-up"
      ]
    },
    "intent": {
      "type": "string",
      "enum": [
        "bot_identity",
        "price_change",
        "price_request",
        "promotion_inquiry",
        "price_objection",
        "negotiation",
        "decline_purchase",
        "efficacy_objection",
        "product_comparison",
        "authenticity_question",
        "product_effect",
        "usage_guidance",
        "usage_time",
        "usage_frequency",
        "safety",
        "ineffective",
        "buying",
        "consultation",
        "order_support",
        "knowledge_unknown",
        "other"
      ]
    },
    "propositions": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "speechAct",
          "action",
          "target",
          "topic",
          "field",
          "value",
          "quantity",
          "rawEvidence",
          "confidence"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 32 },
          "speechAct": {
            "type": "string",
            "enum": ["question", "provide_data", "update", "confirm", "reject", "request"]
          },
          "action": {
            "type": "string",
            "enum": [
              "answer_question",
              "set_quantity",
              "provide_order_field",
              "append_delivery_note",
              "continue_order_collection",
              "pause_order",
              "decline_purchase",
              "handoff_to_human",
              "record_fact"
            ]
          },
          "target": { "type": ["string", "null"], "maxLength": 80 },
          "topic": {
            "type": ["string", "null"],
            "enum": [
              "price",
              "promotion",
              "shipping",
              "comparison",
              "effectiveness",
              "usage",
              "child_age",
              "pregnancy",
              "breastfeeding",
              "sensitive_skin",
              "irritation",
              "damaged_goods",
              "delivery",
              "negative_review",
              "order",
              "sweat",
              "odor",
              "other",
              null
            ]
          },
          "field": {
            "type": ["string", "null"],
            "enum": ["recipientName", "phone", "legacyAddress", "deliveryNote", null]
          },
          "value": { "type": ["string", "number", "boolean", "null"] },
          "quantity": { "type": ["integer", "null"], "enum": [1, 2, 3, 4, 5, null] },
          "rawEvidence": { "type": "string", "minLength": 1, "maxLength": 240 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "actions": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "topic",
          "field",
          "value",
          "quantity",
          "issue",
          "reason",
          "fields",
          "confidence",
          "evidence"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "stop_bot",
              "start_customer_care",
              "handoff_to_human",
              "answer_question",
              "record_fact",
              "select_quantity",
              "update_order",
              "continue_order_collection",
              "pause_order",
              "decline_purchase"
            ]
          },
          "topic": {
            "type": ["string", "null"],
            "enum": [
              "price",
              "promotion",
              "shipping",
              "comparison",
              "effectiveness",
              "usage",
              "child_age",
              "pregnancy",
              "breastfeeding",
              "sensitive_skin",
              "irritation",
              "damaged_goods",
              "delivery",
              "negative_review",
              "order",
              "sweat",
              "odor",
              "other",
              null
            ]
          },
          "field": { "type": ["string", "null"] },
          "value": { "type": ["string", "number", "boolean", "null"] },
          "quantity": { "type": ["integer", "null"], "enum": [1, 2, 3, 4, 5, null] },
          "issue": {
            "type": ["string", "null"],
            "enum": [
              "ineffective",
              "irritation",
              "missing_or_damaged",
              "delivery",
              "counterfeit",
              "negative_review",
              "complaint",
              null
            ]
          },
          "reason": { "type": ["string", "null"] },
          "fields": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["recipientName", "phone", "legacyAddress", "deliveryNote"],
            "properties": {
              "recipientName": { "type": ["string", "null"] },
              "phone": { "type": ["string", "null"] },
              "legacyAddress": { "type": ["string", "null"] },
              "deliveryNote": { "type": ["string", "null"] }
            }
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence": {
            "type": "array",
            "maxItems": 3,
            "items": { "type": "string" }
          }
        }
      }
    },
    "claimedSavedFields": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "value"],
        "properties": {
          "field": {
            "type": "string",
            "enum": ["recipientName", "phone", "legacyAddress", "deliveryNote", "quantity"]
          },
          "value": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "maxItems": 5,
      "items": { "type": "string" }
    },
    "knowledgeIds": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string" }
    },
    "knowledgeQueries": {
      "type": "array",
      "maxItems": 6,
      "items": { "type": "string" }
    },
    "unsupportedQuestions": {
      "type": "array",
      "maxItems": 5,
      "items": { "type": "string" }
    },
    "answeredQuestions": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string" }
    },
    "newAngle": {
      "type": ["string", "null"],
      "enum": ["duration_or_cost", "mechanism", "usage", "evidence", "authenticity", "after_sales", null]
    },
    "rejectedArguments": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "string",
        "enum": ["duration_or_cost", "mechanism", "usage", "evidence", "authenticity", "after_sales"]
      }
    },
    "nextStep": {
      "type": "string",
      "enum": ["answer_only", "ask_discovery", "offer_guidance", "collect_order", "handoff", "none"]
    },
    "selectedCtaId": {
      "type": "string",
      "enum": [
        "none",
        "ask_primary_symptom",
        "ask_work_context",
        "offer_usage_guidance",
        "offer_price",
        "ask_quantity",
        "ask_recipient_name",
        "ask_phone",
        "ask_address",
        "confirm_order_review",
        "ask_care_symptom",
        "ask_clarification"
      ]
    },
    "ctaText": { "type": "string", "maxLength": 300 },
    "beneficiaryUpdates": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation", "id", "type", "label", "age", "ageGroup", "confirmed", "evidence"],
        "properties": {
          "operation": { "type": "string", "enum": ["upsert", "activate"] },
          "id": { "type": ["string", "null"] },
          "type": {
            "type": "string",
            "enum": ["self", "spouse", "child", "mother", "father", "other"]
          },
          "label": { "type": "string", "maxLength": 80 },
          "age": { "type": ["integer", "null"], "minimum": 0, "maximum": 120 },
          "ageGroup": {
            "type": "string",
            "enum": ["child", "adolescent", "adult", "older_adult", "unknown"]
          },
          "confirmed": { "type": "boolean" },
          "evidence": { "type": "string", "maxLength": 180 }
        }
      }
    },
    "groundingConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "draftReply": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "draftBubbles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": { "type": "string", "minLength": 1, "maxLength": 650 }
    },
    "topic": {
      "type": ["string", "null"],
      "enum": [
        "price",
        "promotion",
        "shipping",
        "comparison",
        "effectiveness",
        "usage",
        "child_age",
        "pregnancy",
        "breastfeeding",
        "sensitive_skin",
        "irritation",
        "damaged_goods",
        "delivery",
        "negative_review",
        "order",
        "sweat",
        "odor",
        "other",
        null
      ]
    },
    "subject": {
      "type": ["string", "null"],
      "enum": ["customer", "child", "product", "order", null]
    },
    "scenario": {
      "type": ["string", "null"],
      "enum": ["actual", "hypothetical", "past", "unknown", null]
    },
    "replyTo": {
      "type": ["string", "null"],
      "enum": [
        "offer_usage_guidance",
        "offer_price",
        "choose_quantity",
        "confirm_order",
        "care_question",
        null
      ]
    },
    "affirmation": { "type": ["boolean", "null"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "needsClarification": { "type": "boolean" },
    "age": { "type": ["integer", "null"], "minimum": 0, "maximum": 120 },
    "evidence": {
      "type": "array",
      "maxItems": 3,
      "items": { "type": "string" }
    },
    "asksDirectAnswer": { "type": "boolean" },
    "priceFromVnd": { "type": ["number", "null"], "minimum": 0 },
    "priceToVnd": { "type": ["number", "null"], "minimum": 0 },
    "discountAmountVnd": { "type": ["number", "null"], "minimum": 0 },
    "workContext": {
      "type": ["string", "null"],
      "enum": ["outdoor_heavy", "rest_or_stress", "both", null]
    },
    "primarySymptom": {
      "type": ["string", "null"],
      "enum": ["sweat", "odor", "both", null]
    },
    "sweatPresent": { "type": ["boolean", "null"] },
    "odorPresent": { "type": ["boolean", "null"] },
    "priorProduct": {
      "type": ["string", "null"],
      "enum": ["daily_rollon", "specialized", "none", null]
    },
    "priorIrritation": { "type": ["boolean", "null"] }
  }
}
